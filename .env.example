# Copy this file to .env and fill in real values.
# NEVER commit the .env file.

# Postgres (asyncpg) connection string for the app database.
# Local development alternative (requires `pip install aiosqlite`):
#   DATABASE_URL=sqlite+aiosqlite:///./cram_quest.db
DATABASE_URL=postgresql+asyncpg://YOUR-DB-USER:YOUR-DB-PASSWORD@YOUR-DB-HOST:5432/YOUR-DB-NAME?ssl=require

# JWT signing keys. Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=YOUR-SECRET_KEY
REFRESH_SECRET_KEY=YOUR-REFRESH-SECRET_KEY

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_DAYS=30
