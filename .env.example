# Copy this file to .env and fill in real values.
# NEVER commit the .env file.
#
# REQUIRED = no safe default; the app won't work correctly without it.
# OPTIONAL = has a safe default; only set to override it (default shown in the comment).

# [REQUIRED] Postgres (asyncpg) connection string for the app database.
# The default in config.py is a placeholder and won't connect to anything real.
# Local development alternative (requires `pip install aiosqlite`):
#   DATABASE_URL=sqlite+aiosqlite:///./cram_quest.db
DATABASE_URL=postgresql+asyncpg://YOUR-DB-USER:YOUR-DB-PASSWORD@YOUR-DB-HOST:5432/YOUR-DB-NAME?ssl=require

# [REQUIRED] JWT signing keys. Defaults are insecure placeholders — generate
# strong values with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=YOUR-SECRET_KEY
REFRESH_SECRET_KEY=YOUR-REFRESH-SECRET_KEY

# [OPTIONAL] Token lifetimes (defaults: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_DAYS=30

# [OPTIONAL] Heartbeat ("swords_up") endpoint. Set a shared secret to enable it;
# otherwise it returns 503. The rate limit is per client IP.
SWORDS_UP_API_KEY=
SWORDS_UP_RATE_LIMIT=2 per 10 minutes

# [REQUIRED in production] Comma-separated allowed CORS origins (the deployed
# frontend URL(s)). Defaults to the local dev origin http://localhost:5173.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# [OPTIONAL] Development mode; true exposes /docs, /redoc, /openapi.json.
# Keep false in production. (default: false)
ENV_DEV=false

# [OPTIONAL] Rate limiting (slowapi). Limits are per client IP. RATE_LIMIT_DEFAULT
# applies globally to every endpoint; the auth-specific limits are stricter.
# (defaults: enabled / 100/minute / 5 / 3 / 30)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_SIGN_IN=5/minute
RATE_LIMIT_SIGN_UP=3/minute
RATE_LIMIT_REFRESH_SESSION=30/minute
